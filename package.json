{
  "name": "argus-smr-frontend",
  "version": "0.1.0",
  "description": "Система интеллектуального видеомониторинга и контроля графиков строительства «Аргус — СМР»",
  "private": true,
  "type": "module",
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "vite": "^6.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "vite-plugin-svgr": "^4.3.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "sort:css": "postcss \"src/**/*.css\" --replace",
    "format": "npm run lint:fix && npm run sort:css"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "postcss": "^8.5.2",
    "postcss-cli": "^12.0.0",
    "postcss-sorting": "^10.0.0",
    "typescript": "^5.3.3"
  }
}