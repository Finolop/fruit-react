# Используем легковесный образ Node.js
FROM node:18-alpine

# Задаем рабочую папку внутри контейнера
WORKDIR /app

# Копируем только файлы с зависимостями
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем остальной код проекта
COPY . .

# Открываем порт
EXPOSE 3000

# Запускаем сервер для разработки

CMD ["npm", "start"]
